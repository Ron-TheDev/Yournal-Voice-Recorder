    <style name="Theme.AstraTodo.Green.Amoled" parent="Theme.AstraTodo.Amoled">
        <item name="colorPrimary">@color/astra_green_primary</item>
        <item name="colorOnPrimary">@color/astra_green_on_primary</item>
    </style>

    <style name="ThemeOverlay.AstraTodo.Amoled" parent="">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorTertiaryContainer">#303030</item>
        <item name="colorOnTertiaryContainer">#FFFFFF</item>
