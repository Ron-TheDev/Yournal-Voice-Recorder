<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AstraTodo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="bottomSheetDialogTheme">@style/Theme.AstraTodo.BottomSheetDialog</item>
    </style>

    <style name="Theme.AstraTodo.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.AstraTodo.BottomSheet</item>
    </style>

    <style name="Widget.AstraTodo.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.AstraTodo.BottomSheet</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="ShapeAppearance.AstraTodo.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.AstraTodo" parent="Base.Theme.AstraTodo" />

    <style name="Theme.AstraTodo.Blue" parent="Theme.AstraTodo">
        <item name="colorPrimary">@color/astra_blue_primary</item>
        <item name="colorOnPrimary">@color/astra_blue_on_primary</item>
        <item name="colorPrimaryContainer">@color/astra_blue_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/astra_blue_on_primary_container</item>
        <item name="colorSecondary">@color/astra_blue_primary</item>
        <item name="colorTertiary">@color/astra_blue_primary</item>
    </style>

    <style name="Theme.AstraTodo.Purple" parent="Theme.AstraTodo">
        <item name="colorPrimary">@color/astra_purple_primary</item>
        <item name="colorOnPrimary">@color/astra_purple_on_primary</item>
        <item name="colorPrimaryContainer">@color/astra_purple_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/astra_purple_on_primary_container</item>
        <item name="colorSecondary">@color/astra_purple_primary</item>
        <item name="colorTertiary">@color/astra_purple_primary</item>
    </style>

    <style name="Theme.AstraTodo.Red" parent="Theme.AstraTodo">
        <item name="colorPrimary">@color/astra_red_primary</item>
        <item name="colorOnPrimary">@color/astra_red_on_primary</item>
        <item name="colorPrimaryContainer">@color/astra_red_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/astra_red_on_primary_container</item>
        <item name="colorSecondary">@color/astra_red_primary</item>
        <item name="colorTertiary">@color/astra_red_primary</item>
    </style>

    <style name="Theme.AstraTodo.Orange" parent="Theme.AstraTodo">
        <item name="colorPrimary">@color/astra_orange_primary</item>
        <item name="colorOnPrimary">@color/astra_orange_on_primary</item>
        <item name="colorPrimaryContainer">@color/astra_orange_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/astra_orange_on_primary_container</item>
        <item name="colorSecondary">@color/astra_orange_primary</item>
        <item name="colorTertiary">@color/astra_orange_primary</item>
    </style>

    <style name="Theme.AstraTodo.Green" parent="Theme.AstraTodo">
        <item name="colorPrimary">@color/astra_green_primary</item>
        <item name="colorOnPrimary">@color/astra_green_on_primary</item>
        <item name="colorPrimaryContainer">@color/astra_green_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/astra_green_on_primary_container</item>
        <item name="colorSecondary">@color/astra_green_primary</item>
        <item name="colorTertiary">@color/astra_green_primary</item>
    </style>

    <!-- AMOLED Themes -->
    <style name="Theme.AstraTodo.Amoled" parent="Theme.AstraTodo">
        <item name="colorPrimary">@color/astra_blue_primary</item>
        <item name="colorOnPrimary">@color/astra_blue_on_primary</item>
        <item name="colorPrimaryContainer">#1C1C1C</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="colorSecondary">@color/astra_blue_primary</item>
        <item name="colorOnSecondary">@color/astra_blue_on_primary</item>
        <item name="colorSecondaryContainer">#252525</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorTertiary">@color/astra_blue_primary</item>
        <item name="colorOnTertiary">@color/astra_blue_on_primary</item>
        <item name="colorTertiaryContainer">#303030</item>
        <item name="colorOnTertiaryContainer">#FFFFFF</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#1C1C1C</item>
        <item name="colorOnSurfaceVariant">#E0E0E0</item>
        <item name="colorOutline">#444444</item>
        <item name="colorOutlineVariant">#333333</item>
        <item name="colorSurfaceContainer">#1C1C1C</item>
        <item name="colorSurfaceContainerLow">#121212</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerHigh">#252525</item>
        <item name="colorSurfaceContainerHighest">#303030</item>
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">#FFDAD6</item>
    </style>

    <style name="Theme.AstraTodo.Blue.Amoled" parent="Theme.AstraTodo.Amoled">
        <item name="colorPrimary">@color/astra_blue_primary</item>
        <item name="colorOnPrimary">@color/astra_blue_on_primary</item>
    </style>

    <style name="Theme.AstraTodo.Purple.Amoled" parent="Theme.AstraTodo.Amoled">
        <item name="colorPrimary">@color/astra_purple_primary</item>
        <item name="colorOnPrimary">@color/astra_purple_on_primary</item>
