<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_note"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_edit"
        android:shortcutShortLabel="@string/shortcut_new_note_short"
        android:shortcutLongLabel="@string/shortcut_new_note_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.yournal"
            android:targetClass="com.yournal.MainActivity">
            <extra android:name="shortcut" android:value="new_note" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="new_record"
        android:enabled="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:shortcutShortLabel="@string/shortcut_new_record_short"
        android:shortcutLongLabel="@string/shortcut_new_record_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.yournal"
            android:targetClass="com.yournal.MainActivity">
            <extra android:name="shortcut" android:value="new_record" />
        </intent>
    </shortcut>
</shortcuts>
