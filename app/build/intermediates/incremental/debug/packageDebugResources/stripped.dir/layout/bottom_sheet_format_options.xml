<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_card_rounded" />

        <ImageButton
            android:id="@+id/btn_sheet_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close formatting sheet"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- Left Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="14dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="12dp">

                    <ImageButton
                        android:id="@+id/btn_sheet_bold"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Bold"
                        android:src="@drawable/ic_format_bold"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btn_sheet_italic"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Italic"
                        android:src="@drawable/ic_format_italic"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btn_sheet_strike"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Strikethrough"
                        android:src="@drawable/ic_format_strikethrough"
                        app:tint="?attr/colorOnSurface" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Right Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="14dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="12dp">

                    <ImageButton
                        android:id="@+id/btn_sheet_link"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Insert link"
                        android:src="@drawable/ic_format_link"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btn_sheet_image"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Insert image"
                        android:src="@drawable/ic_format_image"
                        app:tint="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btn_sheet_table"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Insert table"
                        android:src="@drawable/ic_format_table"
                        app:tint="?attr/colorOnSurface" />

<!--                    <Button-->
<!--                        android:id="@+id/btn_sheet_footnote"-->
<!--                        style="@style/Widget.AppCompat.Button.Borderless"-->
<!--                        android:layout_width="0dp"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_columnWeight="1"-->
<!--                        android:text="Footnote"-->
<!--                        android:textColor="?attr/colorOnSurface" />-->
<!--                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_columnWeight="1" />-->
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="14dp"
                android:layout_marginTop="16dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="12dp">

                    <Button android:id="@+id/btn_sheet_h1" style="@style/Widget.AppCompat.Button.Borderless" android:text="H1" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <Button android:id="@+id/btn_sheet_h2" style="@style/Widget.AppCompat.Button.Borderless" android:text="H2" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <Button android:id="@+id/btn_sheet_h3" style="@style/Widget.AppCompat.Button.Borderless" android:text="H3" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <Button android:id="@+id/btn_sheet_quote" style="@style/Widget.AppCompat.Button.Borderless" android:text="Quote" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <Button android:id="@+id/btn_sheet_hr" style="@style/Widget.AppCompat.Button.Borderless" android:text="HR" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_columnWeight="1" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="14dp"
                android:layout_marginTop="16dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="12dp">

                    <ImageButton android:id="@+id/btn_sheet_bullet" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Bullet list" android:src="@drawable/ic_format_list_bullet" app:tint="?attr/colorOnSurface" />
                    <ImageButton android:id="@+id/btn_sheet_number" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Numbered list" android:src="@drawable/ic_format_list_numbered" app:tint="?attr/colorOnSurface" />
                    <ImageButton android:id="@+id/btn_sheet_task" android:layout_width="0dp" android:layout_height="48dp" android:layout_columnWeight="1" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Task list" android:src="@drawable/ic_format_list_task" app:tint="?attr/colorOnSurface" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="14dp"
                android:layout_marginTop="16dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="12dp">

                    <Button android:id="@+id/btn_sheet_code_inline" style="@style/Widget.AppCompat.Button.Borderless" android:text="Inline" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <Button android:id="@+id/btn_sheet_code_block" style="@style/Widget.AppCompat.Button.Borderless" android:text="Block" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <Button android:id="@+id/btn_sheet_code_fenced" style="@style/Widget.AppCompat.Button.Borderless" android:text="Fenced" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="14dp"
                android:visibility="gone"
                android:layout_marginTop="16dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="12dp">

                    <Button android:id="@+id/btn_sheet_sup" style="@style/Widget.AppCompat.Button.Borderless" android:text="Sup" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <Button android:id="@+id/btn_sheet_sub" style="@style/Widget.AppCompat.Button.Borderless" android:text="Sub" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                    <Button android:id="@+id/btn_sheet_emoji" style="@style/Widget.AppCompat.Button.Borderless" android:text="Emoji" android:textColor="?attr/colorOnSurface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
