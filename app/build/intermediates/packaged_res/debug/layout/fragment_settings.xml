<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure your experience"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp"/>

        <!-- RECORDING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECORDING"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <!-- Recording Quality -->
            <RelativeLayout
                android:id="@+id/container_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_quality"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_quality"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recording quality"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio bitrate and format"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tv_quality_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="High (128 kbps)  >"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/tv_sampling_rate_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Active Rate: 48000 Hz"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:visibility="visible"/>
                </LinearLayout>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_pause"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Record Stereo"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="True hardware stereo"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_stereo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <!-- Microphone Selection -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_haptics"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_haptics"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Haptic Feedback"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tactile response to actions"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_haptics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Bluetooth Mic -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_bt"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_bt"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bluetooth Microphone"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prefer external audio"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_bluetooth_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Noise Cancellation -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_noise"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_noise"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Noise Cancellation"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suppress background noise"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_noise_cancellation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Block Notifications -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_block"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_delete"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_block"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Block Notifications"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mute interruptions while recording"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_block_calls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Recording Storage -->
            <RelativeLayout
                android:id="@+id/container_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_storage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_save"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_storage"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recording Storage"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_storage_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="External Storage"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:ellipsize="middle"
                        android:singleLine="true"/>
                </LinearLayout>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Block Notifications -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_live_notif"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_live_notif"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Block Notifications"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep recording notifications silent"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_live_notification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- TRANSCRIPTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRANSCRIPTION"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <!-- Auto-transcribe -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_transcribe"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_transcribe"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-transcribe"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Automatically convert voice to text"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_transcribe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Language -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_lang"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_lang"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Language"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transcription language"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="English (US)  >"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Transcription Engine -->
            <RelativeLayout
                android:id="@+id/container_engine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_engine"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_engine"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transcription Engine"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_engine_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vosk (Default)"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Offline Model -->
            <RelativeLayout
                android:id="@+id/container_model_mgmt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_model"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/stat_sys_download"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_model"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline Transcription Model"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_model_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking status..."
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- APPEARANCE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APPEARANCE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <!-- Theme -->
            <RelativeLayout
                android:id="@+id/container_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_theme"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_theme"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App Theme"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/tv_theme_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System Default"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Accent Color -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/icon_accent"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tag"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="?attr/colorOnSurface"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dynamic Color"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Adapt to wallpaper (Android 12+)"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_dynamic_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginVertical="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual Selection"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/container_color_dots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    
                    <View android:id="@+id/dot_blue" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="8dp" android:background="@drawable/bg_color_dot" android:backgroundTint="@color/preset_blue" />
                    <View android:id="@+id/dot_red" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="8dp" android:background="@drawable/bg_color_dot" android:backgroundTint="@color/preset_red" />
                    <View android:id="@+id/dot_purple" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="8dp" android:background="@drawable/bg_color_dot" android:backgroundTint="@color/preset_purple" />
                    <View android:id="@+id/dot_orange" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="8dp" android:background="@drawable/bg_color_dot" android:backgroundTint="@color/preset_orange" />
                    <View android:id="@+id/dot_green" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="8dp" android:background="@drawable/bg_color_dot" android:backgroundTint="@color/preset_green" />
                    <View android:id="@+id/dot_pink" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="8dp" android:background="@drawable/bg_color_dot" android:backgroundTint="@color/preset_pink" />
                    
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- SECURITY & DATA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURITY &amp; DATA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <!-- Biometrics -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_biometrics"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_biometrics"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Require Biometrics"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unlock with fingerprint or face"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_biometrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Screenshots -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_screenshots"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_screenshots"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prevent Screenshots"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Secure app content"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_screenshots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- DATA MANAGEMENT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATA MANAGEMENT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <!-- Import Notes -->
            <RelativeLayout
                android:id="@+id/container_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_import"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_upload"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_import"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Import Notes"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select .txt or .md files"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="16dp"/>

            <!-- Import Recordings -->
            <RelativeLayout
                android:id="@+id/container_import_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/icon_import_audio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tag"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_upload"
                    app:tint="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_import_audio"
                    android:layout_marginStart="16dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Import Recordings"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select audio files"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- About -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:gravity="center"
            android:text="Yournal v1.0.0 (Alpha)\nMade with ❤️"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
